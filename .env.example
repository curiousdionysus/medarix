# Medarix — Docker Compose ortam şablonu.
# Kullanım: copy .env.example .env  (Windows: copy .env.example .env)
# Gerçek parolaları ve secret'ları asla Git'e eklemeyin.

# --- Compose / PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medarix
POSTGRES_USER=medarix
POSTGRES_PASSWORD=medarix
ORTHANC_PASSWORD=orthanc-change-me

# --- Medarix backend ---
MEDARIX_ENVIRONMENT=development
MEDARIX_EXPOSE_HEALTH_DEPS=true
MEDARIX_ALLOW_BOOTSTRAP_ADMIN=true
MEDARIX_ALLOW_LICENSE_ISSUE=true
MEDARIX_ALLOW_LEGACY_UI=true
MEDARIX_COOKIE_SECURE=false

MEDARIX_DATABASE_HOST=postgres
MEDARIX_DATABASE_PORT=5432
MEDARIX_DATABASE_NAME=medarix
MEDARIX_DATABASE_USER=medarix
MEDARIX_DATABASE_PASSWORD=medarix
MEDARIX_REDIS_URL=redis://medarix-redis:6379/0
MEDARIX_AUDIT_HMAC_SECRET=replace-with-vault-secret
MEDARIX_SESSION_JWT_SECRET=replace-with-vault-secret
MEDARIX_LICENSE_SIGNING_SECRET=replace-with-vault-secret
MEDARIX_PATIENT_DATA_KEY=

MEDARIX_CORS_ORIGINS=["http://localhost:8088","http://localhost:5173"]
MEDARIX_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]

MEDARIX_ORTHANC_USERNAME=medarix
MEDARIX_ORTHANC_PASSWORD=orthanc-change-me

MEDARIX_LDAP_ENABLED=false
MEDARIX_LDAP_SERVER_URI=ldap://ad.example.local
MEDARIX_LDAP_BIND_DN=CN=medarix-bind,OU=Service Accounts,DC=example,DC=local
MEDARIX_LDAP_BIND_PASSWORD=replace-with-vault-secret
MEDARIX_LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=local
MEDARIX_LDAP_USER_FILTER=(sAMAccountName={username})

MEDARIX_DEFAULT_ADMIN_USERNAME=admin
MEDARIX_DEFAULT_ADMIN_PASSWORD=admin-change-me

MEDARIX_OLLAMA_BASE_URL=http://ollama:11434/v1
MEDARIX_OLLAMA_MODEL=medarix-ai
# LLM (Yapılandır / asistan) istek zaman aşımı — CPU'da saniye cinsinden (varsayılan 600)
MEDARIX_OLLAMA_REQUEST_TIMEOUT_SECONDS=600
MEDARIX_WHISPER_BASE_URL=http://whisper:8000/v1
MEDARIX_WHISPER_MODEL=Systran/faster-whisper-large-v3

MEDARIX_PACS_AE_TITLE=RADIOLOGY
MEDARIX_PACS_HOST=pacs.example.local
MEDARIX_PACS_PORT=104
MEDARIX_PACS_CALLED_AE_TITLE=HOSPITALPACS
MEDARIX_DICOMWEB_BASE_URL=http://orthanc:8042/dicom-web

# Production (MEDARIX_ENVIRONMENT=production):
# - Strong unique secrets (32+ chars), MEDARIX_PATIENT_DATA_KEY required
# - MEDARIX_ALLOW_BOOTSTRAP_ADMIN=false, MEDARIX_ALLOW_LICENSE_ISSUE=false
# - MEDARIX_ALLOW_LEGACY_UI=false, MEDARIX_COOKIE_SECURE=true
# - MEDARIX_REDIS_URL required; TLS at ingress
